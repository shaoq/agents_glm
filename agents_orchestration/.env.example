# agents_orchestration runtime configuration
# Copy to `.env` and adjust. Every key here MUST also appear in `.env` (project rule).

# --- Storage ---
ORCH_SQLITE_PATH=storage/runtime.sqlite
ORCH_ARTIFACT_DIR=storage/artifacts

# --- Web Research (disabled by default; opt-in per Run Policy) ---
ORCH_WEB_ENABLED=false
ORCH_WEB_ALLOWED_DOMAINS=

# --- Model profiles (OpenAI-compatible; secrets read only at Adapter boundary) ---
ORCH_LLM_API_KEY=
ORCH_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ORCH_MODEL_NORMALIZER=glm-4.7-flash
ORCH_MODEL_PLANNER=glm-4.7-flash
ORCH_MODEL_REVIEWER=glm-4.7-flash

# --- System maximums (Run Policy may only tighten these) ---
ORCH_MAX_TASKS=32
ORCH_MAX_PLAN_DEPTH=4
ORCH_MAX_CONCURRENCY=4
ORCH_MAX_ATTEMPTS_PER_TASK=3
ORCH_MAX_REPLANS=2
ORCH_MAX_REPORT_REVISIONS=2
ORCH_MAX_RESEARCH_STEPS_PER_SEED=12
ORCH_MAX_RESEARCH_DIRECTIONS_PER_SEED=6
ORCH_MAX_RESEARCH_TOKENS_PER_SEED=100000
ORCH_MAX_RESEARCH_COST_USD_PER_SEED=100
ORCH_RUN_DEADLINE_SECONDS=1800

# Applies only to newly proposed Plans; active Plans use their persisted mode.
ORCH_RESEARCH_EXECUTION_MODE=fixed_fanout
# Durable admission reservation persisted before each ResearchAgent call.
ORCH_RESEARCH_REASONING_RESERVATION_TOKENS=256
